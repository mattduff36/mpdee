# Git attributes for MPDEE

# Treat text files appropriately
*.text eol=lf
*.md eol=lf
*.json eol=lf
*.ts eol=lf
*.tsx eol=lf
*.js eol=lf
*.css eol=lf
*.scss eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary

# Large files (>10MB) - use Git LFS
*.psd filter=lfs diff=lfs merge=lfs -text
*.ai filter=lfs diff=lfs merge=lfs -text
